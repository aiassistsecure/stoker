# Copy to .env and fill in. Never commit .env.
# Token for initial login — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOKER_INIT_TOKEN=change-me-on-first-run
# Secret for signing session cookies — generate similarly
SESSION_SECRET=change-me-on-first-run
# Tailscale hostname or IP to bind to (backend binds to Tailscale interface only)
TAILSCALE_HOST=100.x.x.x
# Port
PORT=8443
# Hearth CLI path (if on PATH, just "hearth")
HEARTH_BIN=hearth
# Inference endpoint base URL (llama-server or equivalent)
INFERENCE_URL=http://127.0.0.1:8080
# pin-clientd status endpoint
PIN_STATUS_URL=http://127.0.0.1:8090/status
# Session lifetime in minutes
SESSION_TTL_MIN=120
# Idle shell timeout in minutes
SHELL_IDLE_MIN=15
